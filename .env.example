# Copy this file to .env.local and fill in only the optional values you need.
# Never commit .env.local because it may contain secrets.
# AI provider keys are entered at runtime in the UI, not here.

# Optional: Supabase-backed workflow storage and automation sync.
# Leave both values blank to keep those backend features disabled.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: Resend API key for automation email notifications.
# Vite exposes VITE_* values to the browser, so use a restricted key for local testing.
# Leave blank to keep email delivery disabled.
VITE_RESEND_API_KEY=
